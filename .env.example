# MicroLLM Environment Configuration (Copy to .env if needed)

# HTTP Server Port
PORT=8000

# Optional Bearer API Key for POST /v1/systemone (leave empty to allow unauthenticated local requests)
MICROLLM_API_KEY=

# Optional HuggingFace NLI Model ID (requires: pip install microllm[torch])
# Example: MoritzLaurer/DeBERTa-v3-small-mnli-fever-anli
MICROLLM_HF_MODEL=

# Optional custom directory for `microllm pull` INT8 ONNX profiles (defaults to ~/.cache/microllm)
MICROLLM_CACHE_DIR=
